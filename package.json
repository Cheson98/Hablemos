{
  "name": "hablemos",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "content:assemble": "node scripts/assemble-level.mjs",
    "content:check": "node scripts/validate-content.mjs && tsx scripts/check-answers.ts",
    "content:index": "node scripts/build-index.mjs",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~54.0.0",
    "expo-document-picker": "^14.0.0",
    "expo-file-system": "^19.0.0",
    "expo-notifications": "^0.32.0",
    "expo-sharing": "^14.0.0",
    "expo-speech": "^14.0.0",
    "expo-status-bar": "^3.0.0",
    "react": "19.1.0",
    "react-native": "~0.81.0",
    "react-native-safe-area-context": "^5.6.0",
    "react-native-svg": "^15.12.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0"
  }
}
